{
  "name": "temper",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:agnostic": "node scripts/check-agnostic.mjs",
    "vendor:skills": "node scripts/vendor-skills.mjs",
    "check": "pnpm check:agnostic && pnpm typecheck && pnpm test",
    "dev": "TEMPER_INSTANCE=dev TEMPER_PORT=4610 TEMPER_API_URL=http://127.0.0.1:4610 pnpm --parallel --filter @temper/server --filter @temper/web dev"
  }
}
